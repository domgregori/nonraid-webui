# Copy to .env and adjust. All values shown are the defaults.
#
# NMD_MODE, DOCKER_MODE, SMART_MODE, SHARES_MODE: each is "real" or "mock".
# "real" is the default. The system never picks mock data by itself — it
# runs mock only when you set the value to "mock" by hand. If the real tool
# is missing in "real" mode, calls fail with a clear error instead of a
# silent switch to mock data.

PORT=3001
CORS_ORIGIN=http://localhost:5183

# Single admin account (backend/src/auth/) — created via the frontend's
# first-run setup screen, not here. auth.json holds the credential.
# AUTH_CONFIG_PATH=./data/auth.json
# Set to true once real TLS termination exists in front of this backend —
# false is only correct for a non-TLS dev/test setup. A Secure cookie sent
# over plain HTTP is silently dropped by the browser, breaking login.
COOKIE_SECURE=false
SESSION_TTL_MS=2592000000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

NMD_MODE=real
NMD_BIN=nmdctl
# NMD_SUPERBLOCK=/nonraid.dat

# Set to true if the backend process itself doesn't run as root and instead
# relies on a sudoers rule like:
#   www-data ALL=(root) NOPASSWD: /usr/local/sbin/nmdctl
NMD_USE_SUDO=false

NMD_TIMEOUT_MS=15000

DOCKER_MODE=real

SMART_MODE=real
SMARTCTL_BIN=smartctl
SMART_USE_SUDO=false
SMART_TIMEOUT_MS=10000
SMART_CACHE_TTL_MS=60000

SHARES_MODE=real
# SHARES_CONFIG_PATH=./data/shares.json
SHARE_MOUNT_ROOT=/mnt/user
SMB_CONF_PATH=/etc/samba/smb.conf
EXPORTS_PATH=/etc/exports
SHARES_USE_SUDO=false
# SHARE_ACCESS_CONFIG_PATH=./data/share-access.json

# Host CPU/memory (Dashboard System card) — no mode toggle, always real (see backend/README.md).
SYSTEM_STATS_INTERVAL_MS=2000

USERS_MODE=real
USERS_USE_SUDO=false
# Managed users/groups live at uid/gid >= this — never touches real host accounts below it.
USERS_UID_RANGE_START=20000
USERS_SHELL_PATH=/usr/sbin/nologin
USERS_TIMEOUT_MS=15000
