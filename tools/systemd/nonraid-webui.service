[Unit]
Description=nonraid-webui backend (API server, also serves the built frontend)
After=network.target nonraid.service

[Service]
Type=simple
StateDirectory=nonraid-webui
# Creates /run/nonraid-webui (tmpfs, mode 0750 below) fresh on every start/restart - the parent
# directory for the share-link RPC Unix socket (see backend/src/shareLinks/rpcServer.ts and
# config.ts's shareRpcSocketPath). Simpler and more robust than the backend doing its own
# mkdir/chmod/chown dance in application code for the directory itself - this unit owns creating
# it, the app just binds a socket inside it and (best-effort) chowns that socket plus this
# directory to root:nonraid-share so share-server's own dedicated account can reach it. Since this
# unit has no User=/Group= override (runs as root), systemd creates the directory as root:root -
# rpcServer.ts's own chown of the directory afterward is what actually makes it traversable by the
# nonraid-share group; RuntimeDirectoryMode= only sets the initial, pre-chown permissions.
RuntimeDirectory=nonraid-webui
RuntimeDirectoryMode=0750
WorkingDirectory=/var/lib/nonraid-webui
# Production shape: this same process also serves the built frontend (see config.ts's
# serveFrontend doc comment) - previously set via the auto-installed /etc/nonraid/config.toml,
# now a plain env var like everything else in config.ts now that TOML config support is gone.
# Must match install-webui.sh's stage_install() staging path.
Environment=SERVE_FRONTEND=true
Environment=FRONTEND_DIST_PATH=/opt/nonraid-webui/frontend-dist
ExecStart=/usr/bin/node /opt/nonraid-webui/backend/dist/index.js
Restart=on-failure
RestartSec=5
# Default (control-group) sends the stop signal to every process in this unit's cgroup, not just
# the main one - and every share's mergerfs mount is a long-lived process this backend spawns and
# leaves running (see shares/applier/realApplier.ts's mountShare()), landing in that same cgroup by
# plain fork/exec inheritance regardless of mergerfs daemonizing on its own. Confirmed live: that
# killed every share's mergerfs process on every plain `systemctl restart` (an update, a settings
# self-restart, Restart=on-failure above after a crash) - not just a real reboot - forcing a full
# remount that disconnects every client and, for one that keeps a handle open across it (e.g. a
# remote host's own /etc/fstab CIFS mount), leaves it seeing "Stale file handle" afterward. A
# share's mount is logically owned by the array, not by this API process - restarting the one
# shouldn't stop the other. `process` signals only the main PID here; a real host shutdown still
# unmounts every share cleanly via this app's own shutdown hook (system/shutdownHook.ts) before
# this process exits, which is what nonraid.service's own ExecStop actually depends on - this
# setting only stops systemd's cgroup-wide kill from doing it a second time, redundantly, on every
# plain restart too.
KillMode=process

[Install]
WantedBy=multi-user.target
